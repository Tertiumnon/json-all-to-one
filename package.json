{
  "name": "json-all-to-one",
  "version": "0.2.4",
  "description": "JSON files concatenation.",
  "type": "module",
  "main": "./dist/lib.js",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js"
    }
  },
  "bin": {
    "json-all-to-one": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build ./src/lib.ts --outdir dist --target node --format esm && bun build ./src/cli.ts --outdir dist --target node --format esm && tsc -p tsconfig.build.json",
    "compile": "bun build --compile ./src/cli.ts --outfile dist/json-all-to-one",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build",
    "changelog": "npx @tertium/gith changelog",
    "release:patch": "npx @tertium/gith release --patch",
    "release:minor": "npx @tertium/gith release --minor",
    "release:major": "npx @tertium/gith release --major"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tertiumnon/json-all-to-one.git"
  },
  "keywords": [
    "json"
  ],
  "author": "Vitaliy Balabanov <tertiumnon@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Tertiumnon/json-all-to-one/issues"
  },
  "homepage": "https://github.com/Tertiumnon/json-all-to-one#readme",
  "engines": {
    "node": ">=18",
    "bun": ">=1.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
